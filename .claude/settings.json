      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)",
      "Bash(git mv:*)", "Bash(git tag:*)", "Bash(git ls-remote:*)",
      "Bash(gh auth status:*)", "Bash(gh repo edit:*)", "Bash(gh repo view:*)", "Bash(gh release create:*)", "Bash(gh release view:*)",
      "Bash(bash scripts/check.sh:*)", "Bash(date:*)", "Bash(sha1sum:*)", "Bash(wc:*)", "Bash(grep:*)", "Bash(ls:*)"
